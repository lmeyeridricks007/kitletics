    function writeSignature(signature) {
      try {
        w.sessionStorage.setItem(SESSION_KEY, signature);
      } catch (e) {}
    }

    function maybeFire(entry) {
      if (!entry || entry.event !== "defaultVariables") {
        return;
      }

      var md5 = entry.userEmailMD5;
      var sha = entry.userEmailSHA256;
      if (!md5 || !sha) return;

      var signature = md5 + '|' + sha;
      if (readSignature() === signature) return;

      writeSignature(signature);
      w.dataLayer.push({ event: "userLoggedIn" });
    }

    // Catch a defaultVariables event already queued before this script ran
    // (it is pushed by the DefaultVariablesScript rendered just above).
    for (var i = 0; i < w.dataLayer.length; i++) maybeFire(w.dataLayer[i]);

    // ...and any pushed afterwards, until GTM swaps out dataLayer.push on load.
    // Pushes after that point are handled by maybeFireUserLoggedIn (see
    // userLoggedInSignal.ts), which DefaultVariablesLoginSync calls for its
    // late corrections — keep both in sync.
    var nativePush = w.dataLayer.push.bind(w.dataLayer);
    w.dataLayer.push = function () {
      var result = nativePush.apply(null, arguments);
      for (var j = 0; j < arguments.length; j++) maybeFire(arguments[j]);
      return result;
    };
  } catch (e) {}
})();
