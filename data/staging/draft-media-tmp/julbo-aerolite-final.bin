t-variables">
(function () {
  try {
    var w = window;
    w.dataLayer = w.dataLayer || [];

    var vars = { login_status: 'false', userEmailMD5: '', userEmailSHA256: '' };
    var match = document.cookie.match(
      /(?:^|;\s*)__gtm_default_vars=([^;]*)/
    );
    if (match) {
      try {
        var parsed = JSON.parse(decodeURIComponent(match[1]));
        if (parsed) vars = parsed;
      } catch (e) {}
    }

    var prefixes = ["utm_","gclid","iitt","fbclid","campaign_id","ad_id","audience","ranMID","ranEAID","ranSiteID","cto_pld","msclkid","srsltid","gbraid","wbraid","gad_source","gad_campaignid"];
    var marketing = {};
    new URLSearchParams(w.location.search).forEach(function (value, key) {
      for (var i = 0; i < prefixes.length; i++) {
        if (key.indexOf(prefixes[i]) === 0) {
          marketing[key] = value;
          break;
        }
      }
    });

    w.dataLayer.push(
      Object.assign(
        {
          event: 'defaultVariables',
          page_location: w.location.href,
          userEmailMD5: vars.userEmailMD5 || '',
