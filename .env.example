# Public site URL is set in src/content/config.ts (https://kitletics.com)

# Google Search Console HTML tag verification (meta content value only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token (msvalidate.01 content)
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional GA4 measurement ID (G-XXXXXXXX). Loads only when set.
# Consent Mode defaults to denied until a CMP updates consent.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Blob media (production). Leave unset locally to use public/images/.
# MEDIA_BLOB_BASE_URL=https://xxxx.public.blob.vercel-storage.com
# NEXT_PUBLIC_MEDIA_BLOB_BASE_URL=https://xxxx.public.blob.vercel-storage.com
# BLOB_READ_WRITE_TOKEN=  # from Vercel Blob store link — never commit
