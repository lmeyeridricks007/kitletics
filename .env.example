# Public site URL is set in src/content/config.ts (https://kitletics.com)

# Google Search Console HTML tag verification (meta content value only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token (msvalidate.01 content)
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional GA4 measurement ID (G-XXXXXXXX). Never hardcode in source.
# Production Vercel: set NEXT_PUBLIC_GA_MEASUREMENT_ID=G-82Z9YHTT93
# Analytics runs only when VERCEL_ENV=production (or NEXT_PUBLIC_GA_FORCE=1).
# Consent Mode defaults deny analytics_storage until the banner accepts.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GA_FORCE=1

# Ahrefs Web Analytics data-key (from Ahrefs project settings). Production only.
# NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=

# IndexNow (Bing + participants). Server-only — never NEXT_PUBLIC_*.
# Generate: openssl rand -hex 16
# Serve key at https://kitletics.com/indexnow-key.txt (and /{key}.txt via rewrite).
# Do not bulk-submit the full sitemap when enabling.
# INDEXNOW_KEY=
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# Vercel Blob media (production). Leave unset locally to use public/images/.
# MEDIA_BLOB_BASE_URL=https://xxxx.public.blob.vercel-storage.com
# NEXT_PUBLIC_MEDIA_BLOB_BASE_URL=https://xxxx.public.blob.vercel-storage.com
# BLOB_READ_WRITE_TOKEN=  # from Vercel Blob store link — never commit

# Internal /admin/growth (not indexed). Production 404s unless ADMIN_GROWTH_SECRET is set.
# ADMIN_GROWTH_USER=kitletics
# ADMIN_GROWTH_SECRET=
# GROWTH_BACKLINKS_WRITES=1
